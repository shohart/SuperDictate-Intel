#version 450

// VulkanSpike test shader — NOT part of ggml/whisper.cpp. This is a
// deliberately trivial standalone compute shader (element-wise
// C[i] = A[i] + B[i]) used to prove the SPIR-V build+embed+dispatch
// mechanism end to end (Unknown 1 in the spike). See
// scripts/spike-embed-spirv.sh for how this gets compiled to SPIR-V
// and embedded as a checked-in C++ byte array (the same "generate once
// at vendor time, check in the output" strategy used for
// ggml-metal-embed.cpp, applied to Vulkan/SPIR-V instead of Metal
// source).
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufA {
    float a[];
};
layout(std430, binding = 1) readonly buffer BufB {
    float b[];
};
layout(std430, binding = 2) writeonly buffer BufC {
    float c[];
};

layout(push_constant) uniform PushConstants {
    uint n;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.n) {
        return;
    }
    c[idx] = a[idx] + b[idx];
}
